{
  "name": "music-bot",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Self-hosted Discord music player with public metadata and bounded audio pipelines",
  "engines": { "node": ">=24.17.0" },
  "scripts": {
    "start": "node src/run.js",
    "dev": "node --watch src/run.js",
    "doctor": "node scripts/doctor.js",
    "cookies:import": "node scripts/import-cookies.js",
    "test": "node --test",
    "test:audio": "node scripts/audio-smoke.js",
    "test:playback": "node scripts/playback-smoke.js",
    "test:spotify": "node scripts/spotify-check.js",
    "benchmark:startup": "node scripts/startup-benchmark.js",
    "test:providers": "node scripts/provider-smoke.js",
    "test:source": "node scripts/source-smoke.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "opusscript": "0.1.1",
    "spotify-url-info": "3.3.3"
  },
  "optionalDependencies": { "@discordjs/opus": "0.10.0" },
  "overrides": {
    "@discordjs/node-pre-gyp": { "tar": "7.5.22" },
    "prism-media": { "opusscript": "0.1.1" }
  }
}
