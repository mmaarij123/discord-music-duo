DISCORD_TOKEN=
# Default for servers without an override; admins can change it with >prefix !
PREFIX=>

# Optional official Spotify metadata search; leave both blank for API-free mode.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=

DEFAULT_VOLUME=70
MAX_QUEUE_LENGTH=500
MAX_PLAYLIST_TRACKS=100
MAX_SAVED_PLAYLIST_TRACKS=500
IDLE_TIMEOUT_SECONDS=300
AUTOPLAY_ENABLED=false
ENABLE_247_MODE=false
LOG_LEVEL=info

FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
# Optional: ./secrets/youtube.cookies.txt (local Netscape export, never share)
# JSON export: save secrets/youtube.cookies.json, then npm run cookies:import
YOUTUBE_COOKIES_FILE=
SEARCH_CACHE_SECONDS=900
AUDIO_SOURCE_CACHE_SECONDS=300
YOUTUBE_FAST_EXTRACTION=false
SPOTIFY_DISCOVERY_TIMEOUT_MS=2000
METADATA_CONCURRENCY=2
PROCESS_TIMEOUT_SECONDS=45
MAX_TRACK_SECONDS=7200
MAX_PLAYERS=20
AUDIO_STALL_TIMEOUT_SECONDS=20
PLAYBACK_RETRY_LIMIT=2
MEDIA_ROOT=./media
MEDIA_MANIFEST=./media.json
# Optional trusted operator-owned ESM adapters; paths relative to project root.
SPOTIFY_SEARCH_ADAPTER=
RECOMMENDATION_ADAPTER=
